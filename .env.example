# 3D_Game_MVP 환경변수 템플릿 (TECH_SPEC 12장)
# 이 파일을 .env 로 복사한 뒤 값을 **직접** 채운다. .env 는 커밋되지 않는다.
# 값이 없는 상태로 스크립트를 실행하면 오류를 내고 멈춘다.

# 콘셉트 아트 생성 (나노바나나 / Gemini API)
GEMINI_API_KEY=

# Android 업로드 키 비밀번호 (키스토어 파일은 저장소 밖에 보관)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=

# Supabase (게임에 들어가는 공개 값. RLS로 보호)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 토스페이먼츠 테스트 클라이언트 키 (웹 빌드용, 공개 가능)
# 시크릿 키(test_sk_)는 여기가 아니라 Supabase Secrets 에만 넣는다
TOSS_TEST_CLIENT_KEY=
